# Run behind a TLS-terminating reverse proxy. Do NOT publish the container port.
DAV_DATA_DIR=/var/lib/goreecloud-dav
DAV_BASE_URI=/
DAV_REQUIRE_HTTPS=1
# Comma-separated exact reverse-proxy IPs whose X-Forwarded-Proto may be trusted.
# Leave empty unless remote proxy IPs are verified and only that proxy can reach PHP.
DAV_TRUSTED_PROXIES=

# Optional: same independent WebDAV file-byte limit for each account. Blank disables.
# Example: 1073741824 gives every account a separate 1 GiB file-storage ceiling.
# This does not constrain calendar/contact metadata or customize individual accounts.
DAV_ACCOUNT_FILE_QUOTA_BYTES=
